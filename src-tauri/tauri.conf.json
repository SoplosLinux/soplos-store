{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soplos-store",
  "version": "3.0.0-9-beta",
  "identifier": "org.soplos.store",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Soplos Store",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "publisher": "Sergi Perich",
    "homepage": "https://soplos.org",
    "copyright": "Copyright © 2026 Sergi Perich",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Software store for Soplos Linux",
    "longDescription": "Find, install, update and remove applications from APT, Flatpak, Snap and AppImages in one place.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "pkexec",
          "fwupd"
        ],
        "changelog": "../CHANGELOG.md",
        "desktopTemplate": "resources/debian/soplos-store.desktop.hbs",
        "postInstallScript": "resources/debian/postinst",
        "preRemoveScript": "resources/debian/prerm",
        "files": {
          "/usr/share/polkit-1/actions/org.soplos.store.policy": "resources/polkit/org.soplos.store.policy",
          "/usr/share/metainfo/org.soplos.store.metainfo.xml": "resources/appstream/org.soplos.store.metainfo.xml",
          "/usr/share/doc/soplos-store/copyright": "resources/debian/copyright",
          "/usr/share/doc/soplos-store/screenshots/screenshot01.png": "resources/screenshots/screenshot01.png",
          "/usr/share/doc/soplos-store/screenshots/screenshot02.png": "resources/screenshots/screenshot02.png",
          "/usr/share/doc/soplos-store/screenshots/screenshot03.png": "resources/screenshots/screenshot03.png",
          "/usr/share/doc/soplos-store/screenshots/screenshot04.png": "resources/screenshots/screenshot04.png",
          "/usr/share/doc/soplos-store/screenshots/screenshot05.png": "resources/screenshots/screenshot05.png",
          "/usr/share/doc/soplos-store/screenshots/screenshot06.png": "resources/screenshots/screenshot06.png",
          "/usr/share/doc/soplos-store/screenshots/screenshot07.png": "resources/screenshots/screenshot07.png",
          "/usr/share/doc/soplos-store/screenshots/screenshot08.png": "resources/screenshots/screenshot08.png",
          "/usr/share/doc/soplos-store/screenshots/screenshot09.png": "resources/screenshots/screenshot09.png",
          "/usr/share/man/man1/soplos-store.1.gz": "resources/docs/soplos-store.1.gz",
          "/etc/xdg/autostart/soplos-store-tray.desktop": "resources/autostart/soplos-store-tray.desktop",
          "/etc/apt/apt.conf.d/20soplos-store": "resources/apt/20soplos-store",
          "/usr/lib/systemd/user/soplos-store-updates.service": "resources/systemd/soplos-store-updates.service",
          "/usr/lib/systemd/user/soplos-store-updates.timer": "resources/systemd/soplos-store-updates.timer"
        }
      }
    }
  }
}